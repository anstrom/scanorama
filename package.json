{
  "name": "scanorama-docs",
  "version": "0.7.1",
  "description": "Documentation tooling for Scanorama API",
  "private": true,
  "scripts": {
    "docs:lint": "redocly lint docs/swagger/swagger.yaml",
    "docs:validate": "redocly lint docs/swagger/swagger.yaml --format summary",
    "docs:build": "redocly build-docs docs/swagger/swagger.yaml --output docs/swagger/index.html",
    "docs:serve": "redocly preview-docs docs/swagger/swagger.yaml",
    "docs:bundle": "redocly bundle docs/swagger/swagger.yaml --output docs/swagger/bundled.yaml",
    "spectral:lint": "vacuum lint docs/swagger/swagger.yaml",
    "openapi:validate-for-codegen": "redocly lint docs/swagger/swagger.yaml --extends=recommended",
    "openapi:check-schema": "js-yaml docs/swagger/swagger.yaml > /dev/null && echo 'OpenAPI schema is valid YAML'"
  },
  "devDependencies": {
    "@quobix/vacuum": "0.30.6",
    "@redocly/cli": "2.57.0",
    "js-yaml": "4.3.2"
  },
  "overrides": {
    "glob": "13.0.6",
    "debug": "4.4.3",
    "color-name": "2.1.1",
    "color-convert": "3.1.3",
    "chalk": "5.6.2",
    "ansi-styles": "6.2.3",
    "yargs": "18.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anstrom/scanorama.git"
  },
  "keywords": [
    "api-documentation",
    "openapi",
    "swagger",
    "validation",
    "documentation"
  ],
  "author": "Scanorama Team",
  "license": "MIT"
}

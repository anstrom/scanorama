#!/bin/bash

# Pre-push hook — runs the mandatory test gate before every push.
# See: CLAUDE.md "Before Every Push"

set -e

cd "$(git rev-parse --show-toplevel)"

echo "Pre-push checks..."

echo "  backend tests..."
# Exclude frontend/node_modules: some npm packages ship Go sources that
# ./... would pick up locally but CI (which has no node_modules) never sees.
# shellcheck disable=SC2046 # word splitting the package list is intended
if ! go test -short -race $(go list ./... | grep -v /frontend/node_modules/); then
    echo "Backend tests failed."
    exit 1
fi

# Same frontend checks as the CI Frontend Tests job.
echo "  frontend lint..."
if ! (cd frontend && npm run lint --silent); then
    echo "Frontend lint failed."
    exit 1
fi

echo "  frontend type-check and build..."
if ! build_output=$(cd frontend && npm run build --silent 2>&1); then
    echo "$build_output"
    echo "Frontend type-check or build failed."
    exit 1
fi

echo "  frontend tests..."
if ! (cd frontend && npx vitest run --reporter=dot 2>&1); then
    echo "Frontend tests failed."
    exit 1
fi

echo "  swagger drift..."
if ! make docs > /dev/null 2>&1; then
    echo "make docs failed — fix before pushing."
    exit 1
fi
if ! git diff --exit-code docs/swagger/ frontend/src/api/types.ts > /dev/null 2>&1; then
    echo ""
    echo "Swagger spec is out of sync with code annotations."
    echo "Run 'make docs' and commit the updated files before pushing:"
    echo "  docs/swagger/swagger.json"
    echo "  docs/swagger/swagger.yaml"
    echo "  docs/swagger/docs.go"
    echo "  frontend/src/api/types.ts"
    exit 1
fi

echo "Pre-push checks passed."

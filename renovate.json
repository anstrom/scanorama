{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly"],
  "labels": ["dependencies"],
  "assignees": ["anstrom"],
  "reviewers": ["anstrom"],
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "0 days",
    "labels": ["security"],
    "assignees": ["anstrom"],
    "reviewers": ["anstrom"]
  },
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am"]
  },
  "gomod": {
    "postUpdateOptions": ["gomodTidy"]
  },
  "packageRules": [
    {
      "description": "Wait before proposing newly published versions; security alerts are exempt (see vulnerabilityAlerts)",
      "matchPackageNames": ["*"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Go toolchain bumps carry stdlib CVE fixes and are not raised as vulnerability alerts; no age gate",
      "matchDatasources": ["golang-version"],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchManagers": ["gomod"],
      "groupName": "Go modules",
      "labels": ["dependencies", "go"]
    },
    {
      "description": "Keep toolchain bumps separate — they carry stdlib security fixes",
      "matchManagers": ["gomod"],
      "matchDatasources": ["golang-version"],
      "groupName": "Go toolchain",
      "labels": ["dependencies", "go", "security"]
    },
    {
      "matchManagers": ["npm"],
      "groupName": "npm dependencies",
      "labels": ["dependencies", "npm"]
    },
    {
      "description": "Hold tailwind: Renovate's npm cannot fetch @tailwindcss/oxide-wasm32-wasi (EALLOWREMOTE), so the lockfile is not regenerated and npm ci fails. Build-time tooling only; may also suppress its security PRs, bump by hand. Remove when #1117 is done.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["tailwindcss", "@tailwindcss/**"],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "labels": ["dependencies", "github-actions"]
    },
    {
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Actions and base images ship majors routinely (checkout, setup-go, codecov); keep proposing them",
      "matchManagers": ["github-actions", "dockerfile", "docker-compose"],
      "matchUpdateTypes": ["major"],
      "enabled": true
    }
  ]
}
